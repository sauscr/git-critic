# gcritic: секреты и переопределения настроек.
# Рабочая копия: %USERPROFILE%\.gcritic\.env (install.ps1 создаёт её из этого шаблона).
# Переменные окружения важнее этого файла. Пустое значение = по умолчанию.
# Описание всех переменных: packages/core/src/gcritic_core/settings.py

# Кто пишет обзор: auto | openai | codex | claude (по умолчанию auto).
#   openai — по API-ключу ниже;
#   codex  — через вход ChatGPT (codex login), ключ не нужен;
#   claude — через вход Claude Code (claude), ключ не нужен.
#   auto   — есть ключ → openai, иначе codex, иначе claude.
GCRITIC_BACKEND=
# Ключ OpenAI для бэкенда openai.
OPENAI_API_KEY=

# Модель для ревью (по умолчанию gpt-4o-mini).
GCRITIC_MODEL=
# Температура ответа, 0..2 (по умолчанию 0.9).
GCRITIC_TEMPERATURE=
# Лимит символов кода на ревью, минимум 1000 (по умолчанию 60000).
GCRITIC_MAX_CHARS=
# Таймаут запроса к OpenAI, секунды (по умолчанию 90).
GCRITIC_TIMEOUT=
# Модель для codex (пусто — из ~/.codex/config.toml).
GCRITIC_CODEX_MODEL=
# Модель для claude: sonnet | opus | haiku (по умолчанию sonnet).
GCRITIC_CLAUDE_MODEL=
# Таймаут вызова codex/claude, секунды (по умолчанию 300).
GCRITIC_CLI_TIMEOUT=
# Сколько последних коммитов ревьюить при чистой рабочей копии (по умолчанию 5).
GCRITIC_REVIEW_COMMITS=
# Сколько коммитов показывает /log без аргумента (по умолчанию 20).
GCRITIC_LOG_COUNT=
# Глубина графика /stats, дни (по умолчанию 7).
GCRITIC_STATS_DAYS=
# Шрифт логотипа: larry3d | 3d-ascii | bloody | delta_corps_priest_1 | sub-zero | poison
# (или любой шрифт pyfiglet; примерить в оболочке: /logo). По умолчанию larry3d.
GCRITIC_LOGO_FONT=
# Демо-заставка при запуске: 1 / 0 (по умолчанию 1).
GCRITIC_INTRO=
# Длительность заставки, секунды (по умолчанию 4).
GCRITIC_INTRO_SEC=
# Файл истории ввода (по умолчанию %USERPROFILE%\.gcritic\history).
GCRITIC_HISTORY_FILE=
